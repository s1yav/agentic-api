{
  "name": "agentic-api",
  "version": "1.0.0",
  "description": "Multi-agent task orchestrator utilizing structured outputs and state graphs in TypeScript.",
  "main": "dist/ai/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/ai/index.js",
    "start:pm-server": "npm run build && node dist/ai/agents/product-manager-agent/flow-server.js",
    "test": "npx tsc --project tsconfig.test.json && node --test dist/tests/errors/index.test.js dist/tests/reusable-components/flow-server-component.test.js dist/tests/agents/product-manager-agent/introduce-product-manager.test.js dist/tests/agents/product-manager-agent/generate-technical-prd.test.js dist/tests/agents/product-manager-agent/break-down-user-story.test.js dist/tests/agents/product-manager-agent/assess-technical-tradeoffs.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s1yav/agentic-api.git"
  },
  "keywords": [
    "typescript",
    "agentic",
    "orchestrator",
    "ai"
  ],
  "author": "s1yav",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/s1yav/agentic-api/issues"
  },
  "homepage": "https://github.com/s1yav/agentic-api#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@genkit-ai/ai": "^1.40.1",
    "@genkit-ai/express": "^1.41.0",
    "@genkit-ai/google-cloud": "^1.40.1",
    "@genkit-ai/google-genai": "^1.40.1",
    "@pulumi/gcp": "^9.0.0",
    "@pulumi/pulumi": "^3.113.0",
    "firebase-admin": "^14.2.0",
    "genkit": "^1.40.1"
  }
}
